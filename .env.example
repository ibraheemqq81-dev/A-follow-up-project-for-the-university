# .env.example — قالب متغيرات البيئة المطلوبة

# PORT (افتراضياً 3000)
PORT=3000

# NODE_ENV (development / production)
NODE_ENV=development

# JWT Secret (مفتاح سري للتوقيع - يتم إنشاؤه تلقائياً في حال عدم توفره)
JWT_SECRET=your_jwt_secret_key_here

# Supabase (اختياري - في حال استخدام خدمات Supabase الخارجية)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
